{"type":"frame-snapshot","snapshot":{"callId":"call@11","phase":"after","pageId":"page@adf38d80f7b8dcc101b87b7ce93d151d","frameId":"frame@18c0ee2ec48dd06b75c47514598627a2","frameUrl":"http://localhost:5173/#/login","doctype":"html","html":["HTML",{"lang":"en"},["HEAD",{},["BASE",{"href":"http://localhost:5173/#/login"}],"\n    ","\n\n    ","\n\n    ",["META",{"charset":"utf-8"}],"\n    ",["LINK",{"rel":"icon","type":"image/jpeg","href":"./santa-icon.jpg"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0"}],"\n    ",["META",{"name":"description","content":"Christmas Shopping List with Family Tracker and Wishlists"}],"\n    ",["TITLE",{},"Christmas Shopping List"],"\n  ",["STYLE",{},"@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Mountains+of+Christmas:wght@700&display=swap');\r\n\r\n:root {\r\n  --bg-gradient-start: #061412;\r\n  --bg-gradient-end: #140818;\r\n  --primary: #dc2626;\r\n  --primary-hover: #b91c1c;\r\n  --gold: #f59e0b;\r\n  --gold-hover: #d97706;\r\n  --pine: #10b981;\r\n  --text-main: #f8fafc;\r\n  --text-muted: #cbd5e1;\r\n  --glass-bg: rgba(15, 23, 42, 0.55);\r\n  --glass-border: rgba(255, 255, 255, 0.12);\r\n  --error: #ef4444;\r\n}\r\n\r\n* {\r\n  box-sizing: border-box;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\nbody {\r\n  font-family: 'Outfit', sans-serif;\r\n  background: linear-gradient(135deg, var(--bg-gradient-start) 0%, #0d1b2a 50%, var(--bg-gradient-end) 100%);\r\n  background-attachment: fixed;\r\n  color: var(--text-main);\r\n  min-height: 100vh;\r\n  -webkit-font-smoothing: antialiased;\r\n  overflow-x: hidden;\r\n  position: relative;\r\n}\r\n\r\n/* Utilities */\r\n.glass-card {\r\n  background: var(--glass-bg);\r\n  backdrop-filter: blur(16px);\r\n  -webkit-backdrop-filter: blur(16px);\r\n  border: 1px solid var(--glass-border);\r\n  border-radius: 24px;\r\n  padding: 2rem;\r\n  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.1);\r\n  position: relative;\r\n  z-index: 2;\r\n}\r\n\r\n.btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 0.75rem 1.5rem;\r\n  border-radius: 12px;\r\n  font-family: inherit;\r\n  font-weight: 600;\r\n  border: none;\r\n  cursor: pointer;\r\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\r\n  gap: 0.5rem;\r\n}\r\n\r\n.btn-primary {\r\n  background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);\r\n  color: white;\r\n  box-shadow: 0 4px 16px rgba(220, 38, 38, 0.45);\r\n  border: 1px solid rgba(255, 255, 255, 0.15);\r\n}\r\n\r\n.btn-primary:hover {\r\n  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 6px 22px rgba(220, 38, 38, 0.6);\r\n}\r\n\r\n.btn-primary:disabled {\r\n  opacity: 0.65;\r\n  cursor: not-allowed;\r\n  transform: none;\r\n}\r\n\r\n.btn-gold {\r\n  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);\r\n  color: #1a0f02;\r\n  font-weight: 700;\r\n  box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);\r\n}\r\n\r\n.btn-gold:hover {\r\n  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 6px 20px rgba(245, 158, 11, 0.5);\r\n}\r\n\r\n.btn-large {\r\n  width: 100%;\r\n  padding: 1rem;\r\n  font-size: 1.1rem;\r\n}\r\n\r\n/* Login specific */\r\n.login-container {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 1.5rem;\r\n  position: relative;\r\n  z-index: 2;\r\n}\r\n\r\n.login-card {\r\n  width: 100%;\r\n  max-width: 440px;\r\n  text-align: center;\r\n  position: relative;\r\n  z-index: 10;\r\n  border: 1px solid rgba(251, 191, 36, 0.25);\r\n  box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.8), 0 0 40px rgba(220, 38, 38, 0.15);\r\n}\r\n\r\n.icon-wrapper {\r\n  width: 90px;\r\n  height: 90px;\r\n  border-radius: 22px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  margin: 0 auto 1.25rem;\r\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.title {\r\n  font-size: 2.5rem;\r\n  font-weight: 800;\r\n  margin-bottom: 0.5rem;\r\n  background: linear-gradient(to right, #ffffff, #fef08a, #f8fafc);\r\n  -webkit-background-clip: text;\r\n  -webkit-text-fill-color: transparent;\r\n  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);\r\n}\r\n\r\n.subtitle {\r\n  color: var(--text-muted);\r\n  margin-bottom: 2rem;\r\n  font-size: 1.05rem;\r\n  line-height: 1.5;\r\n}\r\n\r\n.error-message {\r\n  background: rgba(239, 68, 68, 0.15);\r\n  color: #f87171;\r\n  padding: 1rem;\r\n  border-radius: 12px;\r\n  margin-bottom: 1.5rem;\r\n  border: 1px solid rgba(239, 68, 68, 0.3);\r\n}\r\n\r\n/* Festive Decorative Ambient Blobs */\r\n.blob {\r\n  position: absolute;\r\n  filter: blur(100px);\r\n  z-index: 0;\r\n  opacity: 0.35;\r\n  border-radius: 50%;\r\n  animation: float 12s infinite ease-in-out alternate;\r\n  pointer-events: none;\r\n}\r\n\r\n.blob-1 {\r\n  top: -10%;\r\n  left: -5%;\r\n  width: 45vw;\r\n  height: 45vw;\r\n  background: #064e3b; /* Deep Evergreen Pine */\r\n}\r\n\r\n.blob-2 {\r\n  bottom: -10%;\r\n  right: -5%;\r\n  width: 40vw;\r\n  height: 40vw;\r\n  background: #991b1b; /* Rich Holiday Crimson */\r\n  animation-delay: -6s;\r\n}\r\n\r\n@keyframes float {\r\n  0% { transform: translate(0, 0) scale(1); }\r\n  100% { transform: translate(4%, 4%) scale(1.08); }\r\n}\r\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"aria-hidden":"true","style":"position: fixed; top: 0px; left: 0px; width: 100%; height: 100%; pointer-events: none; overflow: hidden; z-index: 1;"},["STYLE",{},"\n        @keyframes snowfallDrift {\n          0% {\n            transform: translateY(-20px) translateX(0);\n          }\n          50% {\n            transform: translateY(50vh) translateX(15px);\n          }\n          100% {\n            transform: translateY(105vh) translate